# Required repository secrets:
#   CONAN2_USER_SECRET     - Conan remote login username
#   CONAN2_PASSWORD_SECRET - Conan remote login password
#   AQUAPI_USERNAME_SECRET - devpi username for wheel uploads
#   AQUAPI_PASSWORD_SECRET - devpi password for wheel uploads
#   AQUAVEO_GITHUB_TOKEN   - GitHub token for release asset uploads
# Optional setting, readable as either a variable or a secret
# (Settings > Secrets and variables > Actions), on the repository or the
# organization:
#   AQUAPI_URL_DEV         - devpi index URL for wheel uploads. Resolved in
#                            this order: the *variable* AQUAPI_URL_DEV, then
#                            the *secret* of the same name, then the public
#                            dev index. Both names are read because the
#                            secret is where this value has always lived,
#                            and editing it there has to keep working.
#
#                            Mind the precedence -- it is the one way to get
#                            this wrong. A non-empty variable wins, and
#                            editing the secret then changes nothing, with
#                            no error to say so. An empty variable does not
#                            win: it falls through to the secret. The
#                            deploy step logs which of the three supplied
#                            the URL, so read that before editing either.
#
#                            Masking follows the secret's value, not the
#                            name it was read under: while the secret holds
#                            this URL, the log shows `***` even when the
#                            variable supplied it. Delete the secret once
#                            the variable is authoritative, and the upload
#                            target reads in clear.
#
# Each secret is set on the steps that use it, never on the job. Job-level
# env is inherited by every step, including the one that runs the library's
# own test suite inside `conan create` and the pinned third-party actions;
# none of those has a use for a deploy credential.
#
# The Conan pair rides on the build and deploy steps rather than on a
# `conan remote login` step ahead of them. Both commands run the Conan
# setup themselves and neither logs in: Conan reads CONAN_LOGIN_USERNAME
# and CONAN_PASSWORD from the environment, and `conan remote login` with
# no credentials to hand it prompts -- on a runner, a job that hangs
# rather than one that says what is missing.
#
# Note what step scoping does and does not buy for that pair. The build
# step is the one that runs `conan create`, so the library's own suite
# does see it -- unavoidably, since resolving the dependencies is what
# the credentials are for. What scoping keeps it away from is every step
# with no Conan business: the pinned third-party actions, the artifact
# uploads, and the wheel publish, none of which a job-level `env:` could
# have been kept from.
#
# Third-party actions are pinned to a commit SHA with the tag in a trailing
# comment. A tag is a movable ref in someone else's repository: whoever owns
# it can retarget it at new code, which then runs here in a job whose steps
# hold the Conan login and the deploy secrets, and can write GITHUB_ENV for
# every step after it. Update a pin by resolving the new tag
# (`gh api repos/<owner>/<repo>/commits/<tag> --jq .sha`) and editing the
# template -- not the generated file.
#
# Every job installs `xmsconan[ci]` from the public Aquaveo index -- the
# extra pins conan, cmake, gcovr and the flake8 plugins in xmsconan's own
# pyproject.toml -- and the tools read the package version from
# GITHUB_REF_NAME themselves when GITHUB_REF_TYPE is `tag` (0.0.0
# otherwise), so no step exports a version for the next one and no action
# is needed to find the tag. See docs/USAGE.md §10.3.
#
# Generated by xmsconan_ci — do not edit manually.
#
# GitHub runs the C++ tests inside the build job rather than in a separate
# downstream job, so nothing here passes --defer-cxx-tests and `job build`
# gives [ci].test_shards to the packager itself: above 1, the recipe skips
# cmake.test() during the build and the staged runner is then executed as
# N gtest shard processes on the same runner. GitLab's builds do the same,
# except its Linux build under [ci].split_tests, whose suite runs in the
# separate `Run C++ Tests` jobs from downloaded artifacts.
#
# Every platform job is the same list: install the toolchain, `xmsconan
# job build`, upload the test artifacts, and on a tag one `xmsconan job
# deploy` per half this platform publishes. What the template used to
# render into those lines is read from build.toml and this job's
# environment instead -- the matrix filter, the wheel directory, the
# artifacts directory, the shard count, the repair platform, the archive's
# name and its contents. See docs/USAGE.md §10.4.
#
# `job deploy --from-cache` is the one thing GitLab's pipeline has no use
# for. There, the build and the deploy are separate jobs on separate
# runners and `.export/` is the hand-off between them; here they are one
# job on one runner, so the packages are already in the cache that built
# them and there is nothing to restore.

<# `--release-skips-testing` on a tag, for a wheel_only library: nothing
   installs a test runner and no tag pipeline runs one, so compiling the
   testing configurations on every release is the whole Debug leg. A flag
   rather than an unconditional rule because a library that publishes
   Conan packages publishes them from a build that keeps its own. #>
<% set gh_release_skips_testing = ' --release-skips-testing' if ci_wheel_only else '' %>
<# The release step. On a tag, every platform job ends with `Upload Zipped
   Conan Packages`, which attaches the archive `job deploy --cache-archive`
   wrote. It is actions/github-script, replacing bruceadams/get-release
   (Node 16) feeding the archived actions/upload-release-asset (Node 12): a
   first-party JavaScript action, which also runs inside the Linux jobs'
   container, where the `gh` CLI is not guaranteed.
   - The token is step env, like every other credential in this file, and
     the script builds its own client from it with the injected getOctokit.
   - github-script compiles the script as the body of a function whose
     parameters are the names it injects: require, __original_require__,
     github, octokit, getOctokit, context, core, exec, glob and io. A script
     that declares one of them with const or let -- `const octokit = ...` --
     is a SyntaxError that fails the step before any request, which is why
     the client here is `client`.
   - The archive is read from GITHUB_WORKSPACE, which in the container is
     the container's own path, and nothing is expanded into the script with
     ${{ }}: every input arrives through the environment.
   - It fails where the pair failed. No published Release for the tag (a
     bare tag push, or a draft) fails the step, with a message saying so,
     and an asset already on the Release fails it rather than being
     replaced. #>
<# The build_type axis each platform job fans out over. Under wheel_only
   the testing configurations that flag drops are the whole Debug half of
   the matrix, since pybind_build_types defaults to Release: a Debug leg on
   a tag matched nothing, and `job build` exited 1 on every platform job of
   every release while branch pipelines, which are not releases, stayed
   green. A tag pipeline's axis therefore leaves out the legs a release
   empties -- the line GitLab draws by keeping its testing builds off a
   tag -- and a branch pipeline keeps them, so the Debug suite still runs
   on every push. The tag list is measured from the matrix rather than
   assumed to be Release: a Debug wheel is not a testing configuration, so
   a library naming Debug in pybind_build_types keeps that leg. One axis
   serves all four jobs, so the list is a union over platforms: a leg only
   one platform empties stays -- a static-runtime pin leaves Windows no
   pybind build, and its Release leg still fails on a tag. A plain list
   without wheel_only, where no job passes the flag, and whenever the two
   lists agree. #>
<% if ci_wheel_only and ci_release_build_types != ci_build_types %>
<% set gh_build_type_axis = "${{ startsWith(github.ref, 'refs/tags/') && fromJSON('" ~ (ci_release_build_types | tojson) ~ "') || fromJSON('" ~ (ci_build_types | tojson) ~ "') }}" %>
# The build_type axis below depends on the pipeline. A release drops the
# testing configurations (`job build --release-skips-testing`), and under
# [matrix].wheel_only a build type can hold nothing else, so a tag runs
# only the build types some platform still builds on a release:
#   tag:    << ci_release_build_types | join(", ") >>
#   branch: << ci_build_types | join(", ") >>
# See docs/USAGE.md §10.1.

<% else %>
<% set gh_build_type_axis = ci_build_types | tojson %>
<% endif %>
name: << display_name >>-CI

on:
  push:
  pull_request:

jobs:
  # ----------------------------------------------------------------------------------------------
  # FLAKE
  # ----------------------------------------------------------------------------------------------
  flake:
    name: Flake Project
    runs-on: ${{ matrix.platform }}

    strategy:
      fail-fast: false
      matrix:
        platform: [ubuntu-latest]
        python-version: ['3.13']

    steps:
      # Checkout Sources
      - name: Checkout Source
        uses: actions/checkout@v7
      # Setup Python
      - name: Setup Python ${{ matrix.python-version }}
        uses: actions/setup-python@v7
        with:
          python-version: ${{ matrix.python-version }}
      # Install Python Dependencies
      - name: Install Python Dependencies
        run: |
          # The plugins the generated .flake8 relies on ride in on the [ci]
          # extra; xmsconan's pyproject.toml says which, and why each one.
          pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
      # Generates .flake8 first, so CI lints with the same config developers
      # use locally. Do not inline the flake8 settings here: that duplicates
      # .flake8.jinja and the two copies drift apart silently. Which package
      # is linted, and with which plugins, is `job lint`'s decision.
      - name: Run Flake
        run: xmsconan job lint

  # ----------------------------------------------------------------------------------------------
  # MAC
  # ----------------------------------------------------------------------------------------------
  mac:
    name: Clang-Latest (${{ matrix.build_type }}, ${{ matrix.python-version }}, Macos)
    runs-on: ${{ matrix.platform }}

    strategy:
      fail-fast: false
      matrix:
        platform: [macos-15]
        python-version: << ci_mac_python_versions | tojson >>
        build_type: << gh_build_type_axis >>

    env:
      MATRIX_NAME: ${{ matrix.platform }}-Clang${{ matrix.compiler-version }}-${{ matrix.build_type }}<< ci_mac_py_suffix >>
      # What this leg builds. `job build` narrows the matrix by $BUILD_TYPE
      # and fans its pybind configuration out over $PYTHON_TARGET_VERSION,
      # which together are the JSON `--filter` this job used to interpolate.
      # The remote URL and the library name were job env too and are
      # build.toml's to state; CTEST_PARALLEL_LEVEL is defaulted by the
      # tool, and only when the runner has not already chosen a value.
      BUILD_TYPE: ${{ matrix.build_type }}
      PYTHON_TARGET_VERSION: ${{ matrix.python-version }}

    steps:
      # Get Correct Version of Xcode
      - uses: maxim-lobanov/setup-xcode@ed7a3b1fda3918c0306d1b724322adc0b8cc0a90  # v1
        with:
          xcode-version: 16.4
      - name: Setup Clang
        run: |
          clang --version
      # Checkout Sources
      - name: Checkout Source
        uses: actions/checkout@v7
      # Setup Python
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v7
        with:
          python-version: ${{ matrix.python-version }}
      # Install Python Dependencies
      - name: Install Python Dependencies
        run: |
          python -m pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
      # Build the Conan Package
      - name: Build the Conan Packages
        run: xmsconan job build<< gh_release_skips_testing >>
        shell: bash
        env:
          CONAN_LOGIN_USERNAME: ${{ secrets.CONAN2_USER_SECRET }}
          CONAN_PASSWORD: ${{ secrets.CONAN2_PASSWORD_SECRET }}
      - name: Upload test artifacts
        uses: actions/upload-artifact@v7
        with:
          name: test-artifacts-${{ env.MATRIX_NAME }}
          path: test_artifacts/
          if-no-files-found: ignore
        if: always()
<% if ci_wheel_enabled_mac %>
      # Repair wheel (Release only)
      - name: Repair wheel
        run: xmsconan job package
        shell: bash
        if: matrix.build_type == 'Release'
      - name: Upload wheel artifact
        uses: actions/upload-artifact@v7
        with:
          name: wheel-${{ runner.os }}<< ci_mac_py_suffix >>
          path: wheelhouse/*.whl
        if: matrix.build_type == 'Release'
      # Upload wheel to Aquapi
      - name: Upload wheel to Aquapi
        run: |
          echo "AQUAPI_URL supplied by $AQUAPI_URL_SOURCE"
          xmsconan job deploy --wheels-only
        shell: bash
        env:
          AQUAPI_USERNAME: ${{ secrets.AQUAPI_USERNAME_SECRET }}
          AQUAPI_PASSWORD: ${{ secrets.AQUAPI_PASSWORD_SECRET }}
          AQUAPI_URL: ${{ vars.AQUAPI_URL_DEV || secrets.AQUAPI_URL_DEV || 'https://public.aquapi.aquaveo.com/aquaveo/dev/' }}
          AQUAPI_URL_SOURCE: ${{ vars.AQUAPI_URL_DEV && 'the AQUAPI_URL_DEV variable' || secrets.AQUAPI_URL_DEV && 'the AQUAPI_URL_DEV secret' || 'the built-in default' }}
        if: startsWith(github.ref, 'refs/tags/') && matrix.build_type == 'Release'
<% endif %>
      # Upload Release to Conan, and archive what was uploaded
      - name: Upload Releases to Conan
        run: xmsconan job deploy --conan-only --from-cache --cache-archive ${{ env.MATRIX_NAME }}.tar.gz
        shell: bash
        env:
          CONAN_LOGIN_USERNAME: ${{ secrets.CONAN2_USER_SECRET }}
          CONAN_PASSWORD: ${{ secrets.CONAN2_PASSWORD_SECRET }}
        if: startsWith(github.ref, 'refs/tags/')
      # Attach the archive `Upload Releases to Conan` just wrote to this tag's
      # GitHub Release. A tag with no published Release fails here, and so
      # does an asset of the same name already on it: nothing is replaced.
      - name: Upload Zipped Conan Packages
        uses: actions/github-script@v9
        env:
          RELEASE_TOKEN: ${{ secrets.AQUAVEO_GITHUB_TOKEN }}
        with:
          script: |
            const fs = require('fs');
            const path = require('path');
            const tag = process.env.GITHUB_REF_NAME;
            const name = `${process.env.MATRIX_NAME}.tar.gz`;
            const client = getOctokit(process.env.RELEASE_TOKEN);
            const {owner, repo} = context.repo;
            let release;
            try {
              release = (await client.rest.repos.getReleaseByTag({owner, repo, tag})).data;
            } catch (error) {
              if (error.status !== 404) {
                throw error;
              }
              core.setFailed(`Tag ${tag} has no published GitHub Release to attach ${name} to. Create the Release, then re-run the failed jobs.`);
              return;
            }
            await client.rest.repos.uploadReleaseAsset({
              owner,
              repo,
              release_id: release.id,
              name,
              data: fs.readFileSync(path.join(process.env.GITHUB_WORKSPACE, name)),
              headers: {'content-type': 'application/zip'},
            });
        if: startsWith(github.ref, 'refs/tags/')

  # ----------------------------------------------------------------------------------------------
  # LINUX
  # ----------------------------------------------------------------------------------------------
  linux:
    name: GCC-13 (${{ matrix.build_type }}<< ci_linux_name_py >>, Linux)
    runs-on: ubuntu-latest

<% if docker_image %>
    container:
      image: << docker_image >>
<% else %>
    container:
      image: ghcr.io/aquaveo/conan-gcc13-py${{ matrix.python-version }}:latest
<% endif %>

    strategy:
      fail-fast: false
      matrix:
        build_type: << gh_build_type_axis >>
        python-version: << ci_linux_python_versions | tojson >>

    env:
      MATRIX_NAME: linux-GCC13-${{ matrix.build_type }}<< ci_linux_py_suffix >>
      # What this leg builds. `job build` narrows the matrix by $BUILD_TYPE
      # and fans its pybind configuration out over $PYTHON_TARGET_VERSION,
      # which together are the JSON `--filter` this job used to interpolate.
      # The remote URL and the library name were job env too and are
      # build.toml's to state; CTEST_PARALLEL_LEVEL is defaulted by the
      # tool, and only when the runner has not already chosen a value.
      BUILD_TYPE: ${{ matrix.build_type }}
      PYTHON_TARGET_VERSION: ${{ matrix.python-version }}

    steps:
      # Checkout Sources
      - name: Checkout Source
        uses: actions/checkout@v7
      # Install Python Dependencies
      - name: Install Python Dependencies
        run: |
          pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
      # Build the Conan Package
      - name: Build the Conan Packages
        run: xmsconan job build<< gh_release_skips_testing >>
        shell: bash
        env:
          CONAN_LOGIN_USERNAME: ${{ secrets.CONAN2_USER_SECRET }}
          CONAN_PASSWORD: ${{ secrets.CONAN2_PASSWORD_SECRET }}
      - name: Upload test artifacts
        uses: actions/upload-artifact@v7
        with:
          name: test-artifacts-${{ env.MATRIX_NAME }}
          path: test_artifacts/
          if-no-files-found: ignore
        if: always()
<% if ci_wheel_enabled_linux %>
      # Repair wheel (Release only)
      - name: Repair wheel
        run: xmsconan job package
        shell: bash
        if: matrix.build_type == 'Release'
      - name: Upload wheel artifact
        uses: actions/upload-artifact@v7
        with:
          name: wheel-${{ runner.os }}<< ci_linux_py_suffix >>
          path: wheelhouse/*.whl
        if: matrix.build_type == 'Release'
      # Upload wheel to Aquapi
      - name: Upload wheel to Aquapi
        run: |
          echo "AQUAPI_URL supplied by $AQUAPI_URL_SOURCE"
          xmsconan job deploy --wheels-only
        shell: bash
        env:
          AQUAPI_USERNAME: ${{ secrets.AQUAPI_USERNAME_SECRET }}
          AQUAPI_PASSWORD: ${{ secrets.AQUAPI_PASSWORD_SECRET }}
          AQUAPI_URL: ${{ vars.AQUAPI_URL_DEV || secrets.AQUAPI_URL_DEV || 'https://public.aquapi.aquaveo.com/aquaveo/dev/' }}
          AQUAPI_URL_SOURCE: ${{ vars.AQUAPI_URL_DEV && 'the AQUAPI_URL_DEV variable' || secrets.AQUAPI_URL_DEV && 'the AQUAPI_URL_DEV secret' || 'the built-in default' }}
        if: startsWith(github.ref, 'refs/tags/') && matrix.build_type == 'Release'
<% endif %>
      # Upload Release to Conan, and archive what was uploaded
      - name: Upload Releases to Conan
        run: xmsconan job deploy --conan-only --from-cache --cache-archive ${{ env.MATRIX_NAME }}.tar.gz
        shell: bash
        env:
          CONAN_LOGIN_USERNAME: ${{ secrets.CONAN2_USER_SECRET }}
          CONAN_PASSWORD: ${{ secrets.CONAN2_PASSWORD_SECRET }}
        if: startsWith(github.ref, 'refs/tags/')
      # Attach the archive `Upload Releases to Conan` just wrote to this tag's
      # GitHub Release. A tag with no published Release fails here, and so
      # does an asset of the same name already on it: nothing is replaced.
      - name: Upload Zipped Conan Packages
        uses: actions/github-script@v9
        env:
          RELEASE_TOKEN: ${{ secrets.AQUAVEO_GITHUB_TOKEN }}
        with:
          script: |
            const fs = require('fs');
            const path = require('path');
            const tag = process.env.GITHUB_REF_NAME;
            const name = `${process.env.MATRIX_NAME}.tar.gz`;
            const client = getOctokit(process.env.RELEASE_TOKEN);
            const {owner, repo} = context.repo;
            let release;
            try {
              release = (await client.rest.repos.getReleaseByTag({owner, repo, tag})).data;
            } catch (error) {
              if (error.status !== 404) {
                throw error;
              }
              core.setFailed(`Tag ${tag} has no published GitHub Release to attach ${name} to. Create the Release, then re-run the failed jobs.`);
              return;
            }
            await client.rest.repos.uploadReleaseAsset({
              owner,
              repo,
              release_id: release.id,
              name,
              data: fs.readFileSync(path.join(process.env.GITHUB_WORKSPACE, name)),
              headers: {'content-type': 'application/zip'},
            });
        if: startsWith(github.ref, 'refs/tags/')

<% if ci_linux_arm %>
  # ----------------------------------------------------------------------------------------------
  # LINUX ARM
  # ----------------------------------------------------------------------------------------------
  linux-arm:
    name: GCC-13 (${{ matrix.build_type }}<< ci_linux_name_py >>, Linux ARM)
    runs-on: ubuntu-24.04-arm

<% if docker_image %>
    container:
      image: << docker_image >>
<% else %>
    container:
      image: ghcr.io/aquaveo/conan-gcc13-py${{ matrix.python-version }}:latest
<% endif %>

    strategy:
      fail-fast: false
      matrix:
        build_type: << gh_build_type_axis >>
        python-version: << ci_linux_python_versions | tojson >>

    env:
      MATRIX_NAME: linux-arm-GCC13-${{ matrix.build_type }}<< ci_linux_py_suffix >>
      # What this leg builds. `job build` narrows the matrix by $BUILD_TYPE
      # and fans its pybind configuration out over $PYTHON_TARGET_VERSION,
      # which together are the JSON `--filter` this job used to interpolate.
      # The remote URL and the library name were job env too and are
      # build.toml's to state; CTEST_PARALLEL_LEVEL is defaulted by the
      # tool, and only when the runner has not already chosen a value.
      BUILD_TYPE: ${{ matrix.build_type }}
      PYTHON_TARGET_VERSION: ${{ matrix.python-version }}

    steps:
      # Checkout Sources
      - name: Checkout Source
        uses: actions/checkout@v7
      # Install Python Dependencies
      - name: Install Python Dependencies
        run: |
          pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
      # Build the Conan Package
      - name: Build the Conan Packages
        run: xmsconan job build<< gh_release_skips_testing >>
        shell: bash
        env:
          CONAN_LOGIN_USERNAME: ${{ secrets.CONAN2_USER_SECRET }}
          CONAN_PASSWORD: ${{ secrets.CONAN2_PASSWORD_SECRET }}
      - name: Upload test artifacts
        uses: actions/upload-artifact@v7
        with:
          name: test-artifacts-${{ env.MATRIX_NAME }}
          path: test_artifacts/
          if-no-files-found: ignore
        if: always()
<% if ci_wheel_enabled_linux %>
      # Repair wheel (Release only)
      - name: Repair wheel
        run: xmsconan job package
        shell: bash
        if: matrix.build_type == 'Release'
      - name: Upload wheel artifact
        uses: actions/upload-artifact@v7
        with:
          name: wheel-${{ runner.os }}-arm64<< ci_linux_py_suffix >>
          path: wheelhouse/*.whl
        if: matrix.build_type == 'Release'
      # Upload wheel to Aquapi
      - name: Upload wheel to Aquapi
        run: |
          echo "AQUAPI_URL supplied by $AQUAPI_URL_SOURCE"
          xmsconan job deploy --wheels-only
        shell: bash
        env:
          AQUAPI_USERNAME: ${{ secrets.AQUAPI_USERNAME_SECRET }}
          AQUAPI_PASSWORD: ${{ secrets.AQUAPI_PASSWORD_SECRET }}
          AQUAPI_URL: ${{ vars.AQUAPI_URL_DEV || secrets.AQUAPI_URL_DEV || 'https://public.aquapi.aquaveo.com/aquaveo/dev/' }}
          AQUAPI_URL_SOURCE: ${{ vars.AQUAPI_URL_DEV && 'the AQUAPI_URL_DEV variable' || secrets.AQUAPI_URL_DEV && 'the AQUAPI_URL_DEV secret' || 'the built-in default' }}
        if: startsWith(github.ref, 'refs/tags/') && matrix.build_type == 'Release'
<% endif %>
      # Upload Release to Conan, and archive what was uploaded
      - name: Upload Releases to Conan
        run: xmsconan job deploy --conan-only --from-cache --cache-archive ${{ env.MATRIX_NAME }}.tar.gz
        shell: bash
        env:
          CONAN_LOGIN_USERNAME: ${{ secrets.CONAN2_USER_SECRET }}
          CONAN_PASSWORD: ${{ secrets.CONAN2_PASSWORD_SECRET }}
        if: startsWith(github.ref, 'refs/tags/')
      # Attach the archive `Upload Releases to Conan` just wrote to this tag's
      # GitHub Release. A tag with no published Release fails here, and so
      # does an asset of the same name already on it: nothing is replaced.
      - name: Upload Zipped Conan Packages
        uses: actions/github-script@v9
        env:
          RELEASE_TOKEN: ${{ secrets.AQUAVEO_GITHUB_TOKEN }}
        with:
          script: |
            const fs = require('fs');
            const path = require('path');
            const tag = process.env.GITHUB_REF_NAME;
            const name = `${process.env.MATRIX_NAME}.tar.gz`;
            const client = getOctokit(process.env.RELEASE_TOKEN);
            const {owner, repo} = context.repo;
            let release;
            try {
              release = (await client.rest.repos.getReleaseByTag({owner, repo, tag})).data;
            } catch (error) {
              if (error.status !== 404) {
                throw error;
              }
              core.setFailed(`Tag ${tag} has no published GitHub Release to attach ${name} to. Create the Release, then re-run the failed jobs.`);
              return;
            }
            await client.rest.repos.uploadReleaseAsset({
              owner,
              repo,
              release_id: release.id,
              name,
              data: fs.readFileSync(path.join(process.env.GITHUB_WORKSPACE, name)),
              headers: {'content-type': 'application/zip'},
            });
        if: startsWith(github.ref, 'refs/tags/')

<% endif %>
  # ----------------------------------------------------------------------------------------------
  # WINDOWS
  # ----------------------------------------------------------------------------------------------
  windows:
    name: Visual Studio ${{ matrix.compiler-version }} (${{ matrix.build_type }}, ${{ matrix.python-version }}, Windows)
    runs-on: ${{ matrix.platform }}

    strategy:
      fail-fast: false
      matrix:
        platform: [windows-2022]
        python-version: << ci_python_versions | tojson >>
        compiler-version: [17]
        build_type: << gh_build_type_axis >>

    env:
      MATRIX_NAME: ${{ matrix.platform }}-VS${{ matrix.compiler-version }}-${{ matrix.build_type }}-py${{ matrix.python-version }}
      # What this leg builds. `job build` narrows the matrix by $BUILD_TYPE
      # and fans its pybind configuration out over $PYTHON_TARGET_VERSION,
      # which together are the JSON `--filter` this job used to interpolate.
      # The remote URL and the library name were job env too and are
      # build.toml's to state; CTEST_PARALLEL_LEVEL is defaulted by the
      # tool, and only when the runner has not already chosen a value.
      BUILD_TYPE: ${{ matrix.build_type }}
      PYTHON_TARGET_VERSION: ${{ matrix.python-version }}

