<% if ci_coverage %>
<% if ci_wheel_only %>
<# There is no "Coverage Build" any more. It used to compile both instrumented
   configurations here, in a job of its own, because instrumentation is part of
   the package_id and so no production binary can satisfy it -- which meant the
   pipeline compiled the Debug testing and pybind configurations twice, once
   clean in the build stage and once instrumented here. 503 of the 1334 objects
   a pipeline compiled were that duplicate.

   The instrumented builds are now build-stage jobs like any other (see the
   fan-out at the top), each reading its own .gcda where it was compiled. What
   is left here is the merge and the gate. #>
<# Merge and gate: no conan and no compiler, just gcovr combining the
   tracefiles the instrumented builds produced and the [coverage] thresholds
   applied to the result.

   The merge can run here, away from the build folders, because each tracefile
   stores its source paths relative to its own build folder's copy of the
   exported tree -- and the repository checkout this job already has is that
   same tree, so it serves as gcovr's --root. That is what keeps a 245 MiB
   build folder from having to travel between jobs to be read. #>
Coverage:
  stage: Coverage
<# Same null-key guard as `dependencies:` and `artifacts: paths:` above. An
   empty `ci_instrumented_build_jobs` is what a [filter] excluding both
   coverage builds produces -- `build_type = "Release"` cancels the Debug C++
   leg and `options.pybind = false` the Python one. coverage_conflicts() warns
   about exactly that and generation continues, so the file still has to
   render: a warning followed by a pipeline GitLab will not parse reads as a
   template bug rather than as the filter problem it is. #>
<% if ci_instrumented_build_jobs %>
  needs:
<% for job in ci_instrumented_build_jobs %>
    - job: "<< job.name >>"
      artifacts: true
<% endfor %>
<% endif %>
<% if ci_split_tests %>
  # Under [ci].split_tests the tests gate the pipeline from the "Run C++ Tests"
  # jobs, so a coverage *gate* miss is advisory here. Only that exit code is
  # forgiven. The tool failing -- an exception, the collect job leaving no
  # summary to read -- still fails the job, because `allow_failure: true`
  # forgave those too, and a Coverage stage reporting green while producing no
  # report at all is how a broken coverage run survived an entire release
  # unnoticed.
  allow_failure:
    exit_codes:
      - << coverage_gate_exit_code >>
<% endif %>
  except:
    - tags
  image: python:<< coverage_python_version >>
  script:
    - pip install "gcovr>=7,<9"
    - pip install --upgrade "xmsconan>=<< xmsconan_version >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan_coverage --phase report build.toml
  artifacts:
<# `when: always` because a gate miss still has a report worth reading -- and
   it is now rendered *here*, so without this the run you most want to look at
   is the one that publishes nothing. #>
    when: always
    reports:
      coverage_report:
        coverage_format: cobertura
        path: cov-cpp.xml
    paths:
      - cov-cpp.xml
      - cov-cpp-summary.json
      - cov-py.xml
      - cov-py-summary.json
      - coverage-html-cpp/
      - coverage-html-py/
<# Printed by the report phase, not gcovr: gcovr's own --txt TOTAL is written
   in the collect job, whose log GitLab does not scrape for the pipeline
   number. An unmeasured C++ layer prints "n/a" and matches nothing here, so it
   cannot publish a percentage that looks like a real measurement. #>
  coverage: '/Coverage total: (\d+\.?\d*%)/'

pages:
  stage: Pages
<# The merged HTML is rendered in "Coverage", so take it from there. That job
   uploads `when: always`, which means the report still publishes on a gate
   miss -- the run you most want to read is the one that failed its threshold.
   `pages` waits for the whole Coverage stage either way; stage ordering, not
   this dependency, is what sequences them. #>
  dependencies:
    - "Coverage"
  script:
    - mkdir -p public
    - cp -r coverage-html-cpp public/cpp
    - HAS_PY=0
    - if [ -d coverage-html-py ]; then cp -r coverage-html-py public/python; HAS_PY=1; fi
    - |
      {
        echo '<!DOCTYPE html>'
        echo '<html lang="en"><head><meta charset="utf-8">'
        echo '<title><< library_name >> coverage</title></head><body>'
        echo '<h1><< library_name >> coverage</h1>'
        echo '<ul>'
        echo '<li><a href="cpp/index.html">C++ coverage (gcovr)</a></li>'
        [ "$HAS_PY" -eq 1 ] && echo '<li><a href="python/index.html">Python coverage (pytest-cov)</a></li>'
        echo '</ul></body></html>'
      } > public/index.html
  artifacts:
    paths:
      - public
  only:
    - master
    - main
<% else %>
<# The pre-restructure coverage stage: a "Coverage Build" that compiles
   both instrumented configurations in a job of its own, and a report job
   that reads what it produced. Kept for repositories that are not
   wheel_only, whose build stage above is still the single looping
   "Conan Build" and so has no instrumented jobs to take tracefiles
   from. #>
<# The instrumented builds, split off from the gate they used to share a job
   with. They are a second full compile of the library -- coverage is part of
   the package_id, so no production build can be reused for them -- and running
   that inside the Coverage-stage job serialized it behind the entire pipeline.

   `needs: []` is what actually schedules this: it starts the job the moment the
   pipeline does, alongside "Conan Build", rather than at its stage's turn.
   Declaring it in an earlier *stage* would not do -- every Test-stage job would
   then wait for this compile, which is the opposite of the point.

   Everything gcovr needs paths for happens here, beside the build folders that
   produced the data: both instrumented builds, the .gcda read, and the HTML
   render. Only rendered artifacts and small JSON cross to the gate below, so
   nothing has to relocate the paths compiled into the .gcno. #>
