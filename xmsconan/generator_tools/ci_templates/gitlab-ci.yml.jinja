<% endif %>

"Conan Deploy - Windows":
  stage: Deploy
  # GLR-UV and `uv venv`, for the reasons spelled out on "Conan Build -
  # Windows" above. This job only restores and uploads a cache tarball, so it
  # does not compile against the interpreter -- it still builds the venv on
  # the matrix ABI so both Windows jobs bootstrap identically and neither can
  # be the one that rots.
  image: GLR-UV
  parallel:
    matrix:
<% for v in ci_python_versions %>
      - PYTHON_TARGET_VERSION: '<< v >>'
<% endfor %>
  # Depend on the whole build job rather than selecting one parallel instance.
  # GitLab does not expand variables inside needs:parallel:matrix, so a selector
  # like "PYTHON_TARGET_VERSION: $PYTHON_TARGET_VERSION" is compared literally,
  # matches no job, and fails the whole pipeline at config time with
  # "undefined need". Listing the matrix values instead would make every deploy
  # instance need every build instance anyway, so this is equivalent and cannot
  # drift out of sync with the matrix above.
  needs:
    - job: "Conan Build - Windows"
      artifacts: true
  artifacts:
    expire_in: '1d'
    paths:
      - conan_packages/
  script:
    - export PACKAGE_VERSION=${CI_COMMIT_TAG:-0.0.0}
    - uv --version
    - uv venv --python ${PYTHON_TARGET_VERSION} .venv
    - source .venv/Scripts/activate
    - uv pip install "conan~=2.31.0" --index-url https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - uv pip install --upgrade "xmsconan>=<< xmsconan_version >>" --index-url https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan_conan_setup
<# The query is repeated on the upload rather than trusted from the save: this
   is the command that reaches the shared remote, and a tarball restored into a
   cache that already holds the other toolchain's binaries of the same
   reference would otherwise publish those too. #>
    - xmsconan_conan_deploy << library_name >> ${PACKAGE_VERSION} --restore .export/<< library_name >>-windows-py${PYTHON_TARGET_VERSION}-${PACKAGE_VERSION}.tar.gz --upload --package-query compiler.version=<< windows_msvc_version >>
    - mkdir -p conan_packages
    <# ${HOME}, not the hard-coded /c/Users/admin the GLR-py* images ran as:
       the conan home is `~/.conan2`, so a runner whose service account is
       anyone else silently produced an empty artifact. GLR-UV is a different
       machine, so the old literal is exactly the kind of assumption this
       migration has to stop making.

       `|| echo`, not `|| true`: with nothing under the cache path -- a
       restore that produced nothing, or a HOME that is not where conan put
       its cache -- the job used to go green and ship an empty
       conan_packages/ artifact with no line in the log saying so. It stays
       non-fatal because the upload above has already succeeded by this point
       and nothing consumes this artifact; it is a snapshot of the cache for
       debugging. #>
    - cp -r ${HOME}/.conan2/p/* conan_packages/ || echo "warning - no Conan packages under ${HOME}/.conan2/p, conan_packages/ artifact will be empty"
  only:
    - tags
  tags:
    - WinVM

