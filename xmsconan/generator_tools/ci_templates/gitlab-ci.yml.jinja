  stage: Coverage
  needs: []
  except:
    - tags
<% if docker_image %>
  image: << docker_image >>
<% elif ci_xvfb %>
  image: docker.aquaveo.com/aquaveo/conan-docker/conan-gcc13-x11-gdal-py<< coverage_python_version >>
<% else %>
  image: docker.aquaveo.com/aquaveo/conan-docker/conan-gcc13-py<< coverage_python_version >>
<% endif %>
  # The resolved coverage ABI, which also names the conan-gcc13 image above --
  # so on those two branches the container interpreter and the ABI the build
  # targets cannot drift apart. Under an explicit [ci].docker_image the image
  # is whatever the repo named and only this pin is resolved, so keeping that
  # image's interpreter in step is the repo's job. xmsconan_coverage exports
