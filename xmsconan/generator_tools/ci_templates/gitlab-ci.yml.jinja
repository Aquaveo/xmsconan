    - pip install --upgrade "xmsconan>=<< xmsconan_version >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan_test_shards --artifacts-dir test_artifacts --label << test_label >> --shards << ci_test_shards if ci_test_shards > 1 else 1 >><% if ci_xvfb %> --xvfb<% endif %>

<% endfor %>
<% endif %>
<% else %>
<% if ci_split_tests %>
