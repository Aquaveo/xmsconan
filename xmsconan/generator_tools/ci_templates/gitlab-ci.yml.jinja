  stage: Package
<% if docker_image %>
  image: << docker_image >>
<% elif ci_xvfb %>
  image: docker.aquaveo.com/aquaveo/conan-docker/conan-gcc13-x11-gdal-py<< gitlab_linux_single_py >>
<% else %>
  image: quay.io/pypa/manylinux_2_28_x86_64
<% endif %>
<% if ci_wheel_only %>
<# Tag-gated to match its only producer. Before the restructure one ungated
   "Conan Build" built every configuration, the wheel included, so an ungated
   Repair Wheel always had something to repair. Now the clean pybind build is
   the only job that emits a wheel and it is `only: tags`, while the branch
   pipeline's instrumented pybind build measures coverage and writes no wheel
   at all. Left ungated this job ran on every branch against an empty
   wheelhouse and failed the pipeline: xmsvtk pipeline 63162,
   "FileNotFoundError: No .whl files found in wheelhouse". #>
  only:
    - tags
<# `needs: optional: true` rather than `dependencies:`: the instrumented pybind
   build is `except: tags`, so it does not exist in the tag pipeline this job
   now runs in. `optional` is the construct for a dependency that may not have
   been created; naming a job that was filtered out is an error. #>
  needs:
<% for job in ci_linux_wheel_jobs %>
    - job: "<< job.name >>"
      artifacts: true
      optional: true
<% endfor %>
<% else %>
  dependencies:
    - Conan Build
<% endif %>
  script:
    - /opt/python/cp313-cp313/bin/pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - /opt/python/cp313-cp313/bin/xmsconan job package
  artifacts:
    expire_in: '1d'
    paths:
      - wheelhouse/
<% endif %>

<% if ci_deploy %>
<% if ci_linux %>
<% if ci_wheel_enabled_linux %>
"Wheel Deploy":
  stage: Deploy
  image: python:3.13
  dependencies:
    - Repair Wheel
  script:
    - pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan job deploy --wheels-only
  only:
    - tags
<% endif %>

"Conan Deploy - Linux":
  stage: Deploy
  image: ubuntu:latest
<% if ci_wheel_only %>
<# No `parallel: matrix` any more. It existed to give each ABI's export tarball
   a leg to restore, back when the ABI fan-out was the only thing that produced
   more than one. Now every taggable configuration exports, and they are not
   all ABIs -- a library build has none -- so the legs no longer line up with
   the tarballs. One job restores the whole set and uploads once, which is also
   one fewer way for two legs to race on the same Conan reference. #>
<# Guarded for the same reason as `artifacts: paths:` above: an empty list
   leaves the key with nothing under it, GitLab parses that as null, and the
   whole file is rejected. Reachable without a deploy misconfiguration --
   `_mark_export_jobs` marks only the jobs whose tag_policy is not "except",
   and a [filter] narrowing the matrix to testing configurations makes every
   Linux job branch-only, while this job stays gated on [ci].deploy alone.
   Dropping the key beats emitting an empty one: with no `dependencies:` GitLab
   hands the job every earlier stage's artifacts, which is the behavior this
   block narrows rather than one it depends on. #>
<% if ci_linux_export_jobs %>
  dependencies:
<% for job in ci_linux_export_jobs %>
    - "<< job.name >>"
<% endfor %>
<% endif %>
<% else %>
<# No `parallel: matrix` here either, for the reason the wheel_only branch
   above gives. `dependencies: - Conan Build` hands every instance the whole
   fan-out's artifacts, so N instances each restored all N tarballs and raced
   to upload the same Conan reference; the per-instance `--restore` name was
   the only thing keeping them apart, and it is gone now that `job deploy`
   globs `.export/` instead of reassembling names the build already composed. #>
  dependencies:
    - Conan Build
<% endif %>
  script:
    - apt-get update
    - apt-get install -y python3-pip python3-venv
    - python3 -m venv .venv
    - source .venv/bin/activate
    - pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
<# Restores every tarball in `.export/` into this job's cache, then uploads
   once. `conan upload <ref>` publishes every package id under the reference,
   so one upload covers the whole restored set -- uploading per tarball would
   push the same recipe repeatedly. #>
    - xmsconan job deploy --conan-only
  only:
    - tags

<% endif %>
<% if ci_windows %>
<% if ci_wheel_enabled_windows %>
"Wheel Deploy - Windows":
  stage: Deploy
<# Runs on a plain Linux image, not a WinVM: xmsconan_wheel_deploy is a devpi
   upload of a wheel the build job already finished with -- repaired there or
   not, depending on [ci].windows_wheel_repair -- so it needs no MSVC toolchain
   and no Windows host. The wheels arrive as artifacts from the build job. #>
  image: python:3.13
<# Depend on the whole build job rather than one parallel instance, for the same
   reason spelled out on "Conan Deploy - Windows" below. Every matrix instance
   stages its own wheel, and each wheel's own ABI tag (cp310 / cp313 / cp314)
   keeps them distinct inside the merged wheelhouse/, so one deploy job uploads
   the whole set. #>
  needs:
    - job: "Conan Build - Windows"
      artifacts: true
  script:
    - pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan job deploy --wheels-only
  only:
    - tags
<% endif %>

"Conan Deploy - Windows":
  stage: Deploy
  # GLR-UV and `uv venv`, for the reasons spelled out on "Conan Build -
  # Windows" above. This job only restores and uploads a cache tarball, so it
  # does not compile against the interpreter; it still bootstraps its venv the
  # way the build job does so neither of the two can be the one that rots.
  image: GLR-UV
  variables:
    # No `parallel: matrix` any more. Restoring and uploading is
    # ABI-independent, and `needs: artifacts: true` on a fanned-out build hands
    # every instance the whole set of tarballs -- so N deploy instances each
    # restored all N and raced to upload the same Conan reference. The
    # per-instance `--restore` name was what kept them apart, and it is gone
    # now that `job deploy` globs `.export/`. The venv still needs *an*
    # interpreter, so this pins the newest ABI the matrix builds.
    PYTHON_TARGET_VERSION: '<< gitlab_windows_single_py >>'
  # Depend on the whole build job rather than selecting one parallel instance.
  # GitLab does not expand variables inside needs:parallel:matrix, so a selector
  # like "PYTHON_TARGET_VERSION: $PYTHON_TARGET_VERSION" is compared literally,
  # matches no job, and fails the whole pipeline at config time with
  # "undefined need".
  needs:
    - job: "Conan Build - Windows"
      artifacts: true
<# No `conan_packages/` artifact any more, and no `cp -r ${HOME}/.conan2/p/*`
   to fill it. It was an unqueried copy of a *shared* runner's Conan cache, so
   on a machine also running the msvc 192 matrix it snapshotted the other
   toolchain's binaries beside this job's -- unreliable for the one question it
   existed to answer, and nothing consumed it. `xmsconan job deploy
   --cache-archive PATH` writes the queried equivalent for anyone who wants a
   snapshot back; the GitHub template uses it for the release asset. #>
  script:
    - uv --version
    - uv venv --python ${PYTHON_TARGET_VERSION} .venv
    - source .venv/Scripts/activate
    - uv pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" --index-url https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
<# The remote and the `--package-query` are the tool's, read from the same
   packager matrix that pins this platform's `compiler.version` -- not literals
   rendered here. A stale literal fails silently: `compiler.version=194` after
   a toolchain bump matches nothing and the upload exits 0 having published
   nothing. #>
    - xmsconan job deploy --conan-only
  only:
    - tags
  tags:
    - WinVM

<% if ci_windows_vs2019 %>
<# Publishes what "Conan Build - Windows VS2019" exported, to
   << vs2019_remote_name >> rather than to the CI remote. The package query is
   repeated here rather than trusted from the save step: this is the command
   that actually reaches a shared remote, and a tarball restored into a cache
   that already holds msvc 194 binaries of the same reference would otherwise
   publish those too.

   No wheel deploy counterpart, and no `conan_packages/` snapshot -- see the
   header on the build job for the wheel reasoning; the snapshot exists to
   debug the msvc 194 pair and a second copy of it would only double the
   artifact. #>
"Conan Deploy - Windows VS2019":
  stage: Deploy
  image: GLR-UV
  variables:
    # One job, not a fan-out, for the reason given on "Conan Deploy - Windows"
    # above; the pinned ABI is only what the venv is built on.
    PYTHON_TARGET_VERSION: '<< gitlab_windows_single_py >>'
  # The whole build job, not one parallel instance, for the reason given on
  # "Conan Deploy - Windows" above: GitLab does not expand variables inside
  # needs:parallel:matrix.
  needs:
    - job: "Conan Build - Windows VS2019"
      artifacts: true
  script:
    - uv --version
    - uv venv --python ${PYTHON_TARGET_VERSION} .venv
    - source .venv/Scripts/activate
    - uv pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" --index-url https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
<# `--platform` is what routes this to << vs2019_remote_name >> rather than the
   CI remote: it also appends that remote (never first -- see the build job's
   note on concurrent remotes.json writers) and restricts the upload to the
   msvc version the same matrix row pins. #>
    - xmsconan job deploy --conan-only --platform << vs2019_platform_key >>
  only:
    - tags
  tags:
    - WinVM
<% endif %>
<% endif %>
<% endif %>

<% if ci_coverage %>
<% if ci_wheel_only %>
<# There is no "Coverage Build" any more. It used to compile both instrumented
   configurations here, in a job of its own, because instrumentation is part of
   the package_id and so no production binary can satisfy it -- which meant the
   pipeline compiled the Debug testing and pybind configurations twice, once
   clean in the build stage and once instrumented here. 503 of the 1334 objects
   a pipeline compiled were that duplicate.

   The instrumented builds are now build-stage jobs like any other (see the
   fan-out at the top), each reading its own .gcda where it was compiled. What
   is left here is the merge and the gate. #>
<# Merge and gate: no conan and no compiler, just gcovr combining the
   tracefiles the instrumented builds produced and the [coverage] thresholds
   applied to the result.

   The merge can run here, away from the build folders, because each tracefile
   stores its source paths relative to its own build folder's copy of the
   exported tree -- and the repository checkout this job already has is that
   same tree, so it serves as gcovr's --root. That is what keeps a 245 MiB
   build folder from having to travel between jobs to be read. #>
Coverage:
  stage: Coverage
<# Same null-key guard as `dependencies:` and `artifacts: paths:` above. An
   empty `ci_instrumented_build_jobs` is what a [filter] excluding both
   coverage builds produces -- `build_type = "Release"` cancels the Debug C++
   leg and `options.pybind = false` the Python one. coverage_conflicts() warns
   about exactly that and generation continues, so the file still has to
   render: a warning followed by a pipeline GitLab will not parse reads as a
   template bug rather than as the filter problem it is. #>
<% if ci_instrumented_build_jobs %>
  needs:
<% for job in ci_instrumented_build_jobs %>
    - job: "<< job.name >>"
      artifacts: true
<% endfor %>
<% endif %>
<% if ci_split_tests %>
  # Under [ci].split_tests the tests gate the pipeline from the "Run C++ Tests"
  # jobs, so a coverage *gate* miss is advisory here. Only that exit code is
  # forgiven. The tool failing -- an exception, the collect job leaving no
  # summary to read -- still fails the job, because `allow_failure: true`
  # forgave those too, and a Coverage stage reporting green while producing no
  # report at all is how a broken coverage run survived an entire release
  # unnoticed.
  allow_failure:
    exit_codes:
      - << coverage_gate_exit_code >>
<% endif %>
  except:
    - tags
  image: python:<< coverage_python_version >>
  script:
    - pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan_coverage --phase report build.toml
  artifacts:
<# `when: always` because a gate miss still has a report worth reading -- and
   it is now rendered *here*, so without this the run you most want to look at
   is the one that publishes nothing. #>
    when: always
    reports:
      coverage_report:
        coverage_format: cobertura
        path: cov-cpp.xml
    paths:
      - cov-cpp.xml
      - cov-cpp-summary.json
      - cov-py.xml
      - cov-py-summary.json
      - coverage-html-cpp/
      - coverage-html-py/
<# Printed by the report phase, not gcovr: gcovr's own --txt TOTAL is written
   in the collect job, whose log GitLab does not scrape for the pipeline
   number. An unmeasured C++ layer prints "n/a" and matches nothing here, so it
   cannot publish a percentage that looks like a real measurement. #>
  coverage: '/Coverage total: (\d+\.?\d*%)/'
<% else %>
<# The pre-restructure coverage stage: a "Coverage Build" that compiles
   both instrumented configurations in a job of its own, and a report job
   that reads what it produced. Kept for repositories that are not
   wheel_only, whose build stage above is still the single looping
   "Conan Build" and so has no instrumented jobs to take tracefiles
   from. #>
<# The instrumented builds, split off from the gate they used to share a job
   with. They are a second full compile of the library -- coverage is part of
   the package_id, so no production build can be reused for them -- and running
   that inside the Coverage-stage job serialized it behind the entire pipeline.

   `needs: []` is what actually schedules this: it starts the job the moment the
   pipeline does, alongside "Conan Build", rather than at its stage's turn.
   Declaring it in an earlier *stage* would not do -- every Test-stage job would
   then wait for this compile, which is the opposite of the point.

   Everything gcovr needs paths for happens here, beside the build folders that
   produced the data: both instrumented builds, the .gcda read, and the HTML
   render. Only rendered artifacts and small JSON cross to the gate below, so
   nothing has to relocate the paths compiled into the .gcno. #>
"Coverage Build":
  stage: Coverage
  needs: []
  except:
    - tags
<% if docker_image %>
  image: << docker_image >>
<% elif ci_xvfb %>
  image: docker.aquaveo.com/aquaveo/conan-docker/conan-gcc13-x11-gdal-py<< coverage_python_version >>
<% else %>
  image: docker.aquaveo.com/aquaveo/conan-docker/conan-gcc13-py<< coverage_python_version >>
<% endif %>
  # The resolved coverage ABI, which also names the conan-gcc13 image above --
  # so on those two branches the container interpreter and the ABI the build
  # targets cannot drift apart. Under an explicit [ci].docker_image the image
  # is whatever the repo named and only this pin is resolved, so keeping that
  # image's interpreter in step is the repo's job. xmsconan_coverage exports
  # the same value itself; declaring it here keeps the job readable without
  # tracing into the packager.
  variables:
    PYTHON_TARGET_VERSION: '<< coverage_python_version >>'
  script:
    - pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan_conan_setup
    - export CTEST_PARALLEL_LEVEL=${CTEST_PARALLEL_LEVEL:-8}
    - xmsconan_coverage --phase collect build.toml
  artifacts:
    expire_in: '1d'
<# `when: always` because the gate below has to run even when collection came
   up short -- reporting an unmeasured layer as a failure is the whole point of
   coverage-status.json, and it can only do that if the file survives. #>
    when: always
    paths:
      - cov-cpp.xml
      - cov-cpp-summary.json
      - cov-py.xml
      - cov-py-summary.json
      - coverage-status.json
      - coverage-html-cpp/
      - coverage-html-py/

<# Report-only: no conan, no compiler, no gcovr -- it reads the JSON the job
   above produced and applies the [coverage] thresholds. It re-declares the
   artifacts so `pages` keeps taking them from this job, and so the cobertura
   report is attached to the job whose result the MR widget shows. #>
Coverage:
  stage: Coverage
  needs:
    - job: "Coverage Build"
      artifacts: true
<% if ci_split_tests %>
  # Under [ci].split_tests the tests gate the pipeline from the "Run C++ Tests"
  # jobs, so a coverage *gate* miss is advisory here. Only that exit code is
  # forgiven. The tool failing -- an exception, the collect job leaving no
  # summary to read -- still fails the job, because `allow_failure: true`
  # forgave those too, and a Coverage stage reporting green while producing no
  # report at all is how a broken coverage run survived an entire release
  # unnoticed.
  allow_failure:
    exit_codes:
      - << coverage_gate_exit_code >>
<% endif %>
  except:
    - tags
  image: python:<< coverage_python_version >>
  script:
    - pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan_coverage --phase report build.toml
  artifacts:
    reports:
      coverage_report:
        coverage_format: cobertura
        path: cov-cpp.xml
    paths:
      - cov-cpp.xml
      - cov-py.xml
<# The rendered HTML deliberately stays on "Coverage Build" rather than being
   re-uploaded here. `needs: artifacts: true` already hands this job the whole
   tree, so listing it again would store a second copy of every gcovr detail
   page and spend the upload in a job that otherwise runs for seconds. `pages`
   takes it from where it was produced. #>
<# Printed by the report phase, not gcovr: gcovr's own --txt TOTAL is written
   in the collect job, whose log GitLab does not scrape for the pipeline
   number. An unmeasured C++ layer prints "n/a" and matches nothing here, so it
   cannot publish a percentage that looks like a real measurement. #>
  coverage: '/Coverage total: (\d+\.?\d*%)/'
<% endif %>

<# One `pages:` for both coverage layouts. The two used to differ in exactly one
   line -- which job the rendered HTML is taken from -- wrapped around fourteen
   `echo`s of identical inline markup, which is the shape where two copies
   drift. The markup is `xmsconan job coverage --pages` now, so the one real
   difference is all that is left here.

   That command also fixes what the shell could not. `cp -r coverage-html-cpp
   public/cpp` on a run whose C++ layer measured nothing printed to stderr,
   carried on, and published an index whose first link 404s; the tool copies and
   links exactly the reports that exist.

   The dependency is the job that *renders* the HTML, and that is not the same
   job in the two layouts. Either way it publishes on a gate miss -- the run you
   most want to read is the one that failed its threshold -- and `pages` waits
   for the whole Coverage stage regardless, because stage ordering, not this
   dependency, is what sequences them. #>
pages:
  stage: Pages
<# An image with an interpreter, which the inline-shell version did not need.
   The same one the Coverage job above runs on, so the two cannot drift. #>
  image: python:<< coverage_python_version >>
  dependencies:
    - "<< 'Coverage' if ci_wheel_only else 'Coverage Build' >>"
  script:
    - pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - xmsconan job coverage --pages
  artifacts:
    paths:
      - public
  only:
    - master
    - main
<% endif %>
