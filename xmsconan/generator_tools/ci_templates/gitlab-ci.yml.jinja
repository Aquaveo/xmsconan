Repair Wheel:
  stage: Package
<% if docker_image %>
  image: << docker_image >>
<% elif ci_xvfb %>
  image: docker.aquaveo.com/aquaveo/conan-docker/conan-gcc13-x11-gdal-py<< gitlab_linux_single_py >>
<% else %>
