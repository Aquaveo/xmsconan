"""
The build.py file for the xms project.
"""
import argparse
import json
import os

from xmsconan.package_tools import packager

import conanfile

# Baseline matrix restriction from the [filter] table in build.toml. It is
# applied before --filter, so the two narrow the matrix together; pass
# --ignore-build-filter to build a configuration it excludes.
BUILD_FILTER = {{ build_filter }}

# arg parse for skip build and skip upload
parser = argparse.ArgumentParser()
parser.add_argument("--skip-build", help="Skip the build step", action="store_true")
parser.add_argument("--upload", help="Complete the conan upload.", action="store_true")
# Defaults to $XMS_VERSION -- the variable every generated CI leg already sets --
# rather than to '*'. As a *glob*, '*' silently widened `conan upload
# <lib>/** -r aquaveo --confirm` to every version of this library sitting in
# the local cache, and made --wheel-dir stage whichever wheel it found. Not
# required=True, though: the generated GitHub CI omits --version on six
# invocations per repo, and args.version also feeds extract_wheel.
parser.add_argument("--version", help="Version to upload (default: $XMS_VERSION)",
                    default=os.environ.get("XMS_VERSION", "*"))
parser.add_argument("--preview", help="Preview the configurations that will be build", action="store_true")
parser.add_argument("--filter", help="Filter dictionary in JSON format")
parser.add_argument("--ignore-build-filter", action="store_true",
                    help="Ignore the [filter] table from build.toml")
parser.add_argument("--build-missing", help="Build missing dependencies from source", action="store_true")
parser.add_argument("--python-only", help="Only build the Python (pybind) configuration", action="store_true")
parser.add_argument("--wheel-dir", help="Extract pre-built wheel from pybind package to this directory")
parser.add_argument("--skip-dependency-libs", action="store_true",
                    help="Do not stage the Conan cache's shared libraries next to the wheel. "
                         "They exist only so the repair tools can resolve imports, so this is "
                         "for a build whose wheel is not repaired.")
parser.add_argument("--repair", help="Repair Linux wheel for manylinux using Docker", action="store_true")
parser.add_argument("--artifacts-dir", help="Save test artifacts to this directory")
parser.add_argument("--test-shards", help="Run tests in N parallel shards (use 'auto' for half CPU count)", default="0")

if __name__ == "__main__":
    args = parser.parse_args()
    if args.test_shards == "auto":
        test_shards = max((os.cpu_count() or 4) // 2, 2)
    else:
        test_shards = int(args.test_shards)
    builder = packager.XmsConanPackager(
        conanfile.LIBRARY_NAME,
        conanfile.__file__,
        build_missing=args.build_missing,
        artifacts_dir=args.artifacts_dir,
        test_shards=test_shards,
        profile_options=conanfile.CONAN_PROFILE_OPTIONS,
        matrix=conanfile.CONAN_MATRIX,
    )
    builder.generate_configurations()
    if BUILD_FILTER and not args.ignore_build_filter:
        print(f"Applying build.toml [filter]: {BUILD_FILTER}")
        builder.filter_configurations(BUILD_FILTER)
    if args.filter:
        filter_options = json.loads(args.filter)
        builder.filter_configurations(filter_options)
    if args.python_only:
        builder.filter_configurations({'options': {'pybind': True}})
    if not builder.configurations:
        # Filters that cancel each other out used to build nothing and exit 0,
        # which reads as a passing build that produced no packages. --preview
        # still exits 0: it is the flag you reach for to diagnose this.
        print(
            "No configurations match the requested filters. Applied: "
            f"build.toml [filter]={BUILD_FILTER if not args.ignore_build_filter else None}, "
            f"--filter={args.filter}, --python-only={args.python_only}"
        )
        if not args.preview:
            exit(1)
    if args.preview:
        builder.print_configuration_table()
        exit(0)
        # Use config_dict as needed
    if not args.skip_build:
        err_count = builder.run()
        if err_count > 0:
            print("errors when building... exiting...")
            exit(1)

    if args.wheel_dir:
        # extract_wheel returns False both when nothing was extracted and when
        # only some of the expected python_versions were -- and in the partial
        # case it has already copied the wheels it did find. Treating that as a
        # warning left a green build with a wheelhouse nobody had checked, no
        # dependency libs staged for the repair step, and whatever was there
        # queued for deploy. --wheel-dir is a request, not a hint.
        if not builder.extract_wheel(args.wheel_dir, version=args.version):
            print(f"error: --wheel-dir {args.wheel_dir} was given but no complete set of "
                  f"wheels was extracted; see the message above.")
            exit(1)
        if not args.skip_dependency_libs:
            libs_dir = os.path.join(args.wheel_dir, 'libs')
            builder.collect_dependency_libs(libs_dir)
        if args.repair:
            builder.repair_linux_wheel(args.wheel_dir)

    if args.upload:
        # `not args.version` as well as the sentinel: an exported-but-empty
        # XMS_VERSION makes os.environ.get return "", which is not "*" and
        # would have uploaded the ref `<lib>/`.
        if not args.version or args.version == "*":
            # Publishing is the one step where the glob is not recoverable:
            # whatever it matched is on the shared remote afterwards.
            print("error: --upload needs a concrete version. Pass --version, or set "
                  "XMS_VERSION (every generated CI leg does).")
            exit(1)
        if builder.upload(version=args.version) != 0:
            print("errors when uploading... exiting...")
            exit(1)
