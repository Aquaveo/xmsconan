<% if ci_wheel_only %>
<# One build job per surviving Linux configuration, not one job looping all of
   them. The loop was sequential, so a pipeline's compiles were serialized
   inside a single container even though the runner has the concurrency to
   overlap them; and it was paired with a "Coverage Build" that recompiled two
   of those same configurations instrumented, because instrumentation is part
   of the package_id and so cannot be satisfied by a production binary. Five
   compiles, three of them of source the pipeline had already compiled.

   Emitting a job per configuration fixes both at once. `needs: []` is what
   actually makes them concurrent -- it starts each job the moment the pipeline
   does, rather than at its stage's turn -- and each job requests exactly the
   shape its consumer needs, so nothing is compiled twice.

   The instrumented jobs run `xmsconan_coverage --phase measure` rather than
   build.py directly. That keeps the whole instrumented path (regenerating with
   XMS_COVERAGE set, pinning the coverage ABI, running the suite, reading .gcda
   beside the .gcno that were written next to it) inside the tool that already
   owns it, and it is why no build folder has to travel: at 245 MiB of .gcno
   against 5.5 MiB of .gcda, moving one would cost more than the compile it
   saves. What leaves each job is a tracefile of a few hundred KB. #>
<% for job in ci_linux_build_jobs %>
"<< job.name >>":
<% if ci_split_tests %>
  stage: Build
<% else %>
  stage: Test
<% endif %>
<% if docker_image %>
  image: << docker_image >>
<% elif ci_xvfb %>
  image: docker.aquaveo.com/aquaveo/conan-docker/conan-gcc13-x11-gdal-py<< coverage_python_version if job.instrumented else (job.python_version or gitlab_linux_single_py) >>
<% else %>
  image: docker.aquaveo.com/aquaveo/conan-docker/conan-gcc13-py<< coverage_python_version if job.instrumented else (job.python_version or gitlab_linux_single_py) >>
<% endif %>
  needs: []
<% if job.tag_policy == "except" %>
  except:
    - tags
<% elif job.tag_policy == "only" %>
  only:
    - tags
<% endif %>
  variables:
    PYTHON_TARGET_VERSION: '<< coverage_python_version if job.instrumented else (job.python_version or gitlab_linux_single_py) >>'
<# What this job has to hand downstream, decided before the block is opened.
