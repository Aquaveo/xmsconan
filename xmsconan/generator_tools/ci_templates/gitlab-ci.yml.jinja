<# One Windows image for every ABI. It replaced the per-version GLR-py310 /
   GLR-py313 images, whose whole purpose was to make `python` on PATH the
   matrix version: the recipe points CMake at the interpreter running conan
   and the generated CMakeLists.txt requires that exact version (see
   check_python_versions), so before GLR-UV the ABI had to be chosen by
   picking an image and could not be changed inside the job. GLR-UV carries
   uv and the pre-loaded 3.10 / 3.13 / 3.14 interpreters, so the script picks
   the ABI itself with `uv venv --python` -- and PY_TAG, which existed only to
   spell an image name, is gone with it.

   `tags: WinVM` below still routes the job to the Windows fleet; `image:`
   only selects which VM template that fleet starts. #>
  image: GLR-UV
  parallel:
    matrix:
<% for v in ci_python_versions %>
      - PYTHON_TARGET_VERSION: '<< v >>'
<% endfor %>
  variables:
    AQUAPI_URL: "https://aquapi.aquaveo.com/aquaveo/dev"
<% if ci_wheel_only %>
<# A branch builds the whole matrix; a tag builds only what it publishes. The
   empty options dict is a filter that matches every configuration, so the
   script can pass `--filter` unconditionally and quoted -- the alternative,
   an interpolated flag that is empty on branches, relies on unquoted word
   splitting to disappear, which is a subtle thing to leave in a release path.

   `rules:` rather than the two mutually exclusive jobs Linux uses. The Linux
   builds had to become separate jobs anyway, one per configuration; this is
   still one job, and splitting it would mean either duplicating forty lines or
   renaming it -- and "Conan Build - Windows" is named by the `needs:` of both
   Windows deploy jobs. #>
    BUILD_MATRIX_FILTER: '{"options":{}}'
  rules:
    - if: $CI_COMMIT_TAG
      variables:
<# Skip the testing configurations. Nothing installs a test runner and no tag
   pipeline runs one -- the Windows job compiled them on every release, and for
   a wheel_only repository the testing configurations are most of the matrix. #>
        BUILD_MATRIX_FILTER: '{"options":{"testing":false}}'
    - when: on_success
<% endif %>
  artifacts:
    expire_in: '1d'
    when: always
    paths:
      - .export
      - test_artifacts/
<# The wheels only, not the whole directory: with `when: always`, a failed
   repair would otherwise upload the several hundred DLLs collect_dependency_libs
   stages in wheelhouse/libs. Wheel Deploy - Windows only needs the .whl files. #>
<% if ci_wheel_enabled_windows %>
      - wheelhouse/*.whl
<% endif %>
  script:
    - export PACKAGE_VERSION=${CI_COMMIT_TAG:-0.0.0}
    - export CTEST_PARALLEL_LEVEL=${CTEST_PARALLEL_LEVEL:-8}
    - echo ${PACKAGE_VERSION}
<# The interpreter every `uv build` in this job's dependency graph builds a
   wheel with. `uv build` given no interpreter discovers one itself and takes
   the newest it can see -- 3.14 on GLR-UV, whichever leg is running -- so a
   3.10 leg produced a cp314 wheel and then could not install it into its own
   venv. Read by uv itself, so unlike a flag on the recipe's own command it
   also reaches the recipe copies of dependencies conan builds from source,
   each of which was exported with whatever xmsconan published it.

   Invisible until GLR-UV: the retired per-ABI images held exactly one
   interpreter and it was the target ABI, so an unpinned discovery could not
   be wrong. One image serving every ABI is the point of the migration, and it
   makes the omission load-bearing. #>
    - export UV_PYTHON=${PYTHON_TARGET_VERSION}
<# uv, not pip, and into a venv of the matrix ABI rather than the machine's
   own interpreter. GLR-UV serves every ABI, so there is no longer a `python`
   on PATH that happens to be the right one -- `uv venv --python` is what
   makes it right, and it must come before anything reads `python`. Activating
   persists for the rest of the script: GitLab runs these lines as one shell.

   `uv --version` first so a runner without uv fails on that line with an
   obvious message, rather than four lines later on a `uv pip install` that
   reads like a packaging problem. #>
    - uv --version
    - uv venv --python ${PYTHON_TARGET_VERSION} .venv
    - source .venv/Scripts/activate
    - python --version
<# cmake comes from the venv, not from the image. The GLR-py310 / GLR-py313
   images carried it on PATH; GLR-UV does not, and every configuration failed
   the same way while conan configured the first dependency it built from
   source ('cmake' is not recognized as an internal or external command).
   Taking it from PyPI makes the job independent of how the runner snapshot is
   provisioned: the wheel is py3-none-win_amd64, so one pin covers every ABI in
   the matrix, and it installs into .venv/Scripts, which the activate above
   already put on PATH. `>=3.21` is the floor the generated CMakeLists
   declares; the Linux jobs build the same sources with cmake 4.x, so nothing
   here needs an upper bound.

   The version check sits after the install rather than before it, unlike the
   Linux jobs where cmake is the image's: a resolution failure should read as
   one instead of surfacing later as a per-configuration build error. #>
    - uv pip install "conan~=2.31.0" "cmake>=3.21" packaging
    - uv pip install --upgrade "xmsconan>=<< xmsconan_version >>" --index-url https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - cmake --version
    - xmsconan_conan_setup
    - xmsconan_gen --version ${PACKAGE_VERSION} build.toml
<% if ci_wheel_only %>
    - python build.py --version ${PACKAGE_VERSION} --filter "${BUILD_MATRIX_FILTER}"<% if ci_wheel_enabled_windows %> --wheel-dir wheelhouse<% if not ci_windows_wheel_repair %> --skip-dependency-libs<% endif %><% endif %> --artifacts-dir test_artifacts
<% else %>
    - python build.py --version ${PACKAGE_VERSION}<% if ci_wheel_enabled_windows %> --wheel-dir wheelhouse<% if not ci_windows_wheel_repair %> --skip-dependency-libs<% endif %><% endif %> --artifacts-dir test_artifacts
<% endif %>
<% if ci_windows_wheel_repair and ci_wheel_enabled_windows %>
<# Windows repairs in place rather than in a separate Package-stage job the way
   Linux does: delvewheel resolves the DLL imports of a win_amd64 .pyd and can
   only run on a Windows host, so a manylinux container cannot stand in. Keeping
   it here also avoids a second WinVM allocation. This mirrors the GitHub
   workflow, which repairs inside its windows job.

   [ci].windows_wheel_repair = false removes this step, and with it the
   dependency-libs staging above that exists only to feed it. delvewheel's
   ignore list excuses vcruntime140 for a cp3xx wheel but not msvcp140, so a
   .pyd with no third-party imports still gets a mangled CRT vendored beside
   it -- which then overrides the runtime XMS supplies to the Python process
   on purpose. A library with nothing to vendor opts out. #>
    - xmsconan_wheel_repair --wheel-dir wheelhouse --platform windows
<% endif %>
<# Queried, like the VS2019 job's save below and for the same reason in the
   mirror direction. A runner's Conan cache is per machine, not per job, and
   `conan cache save <ref>:*` matches by reference -- so with
   [ci].windows_vs2019 on, both toolchains build the same reference on the same
   fleet at the same time, and an unqueried save here would tarball the msvc
   192 binaries and the deploy below would publish them to the production
   `aquaveo` remote at exit 0. Emitted unconditionally rather than only under
   the opt-in: the restriction is a no-op when this is the only toolchain on
   the machine, and a guard that appears only in the configuration that needs
   it is one refactor away from being dropped from the one that does. #>
    - xmsconan_conan_deploy << library_name >> ${PACKAGE_VERSION} --save .export/<< library_name >>-windows-py${PYTHON_TARGET_VERSION}-${PACKAGE_VERSION}.tar.gz --package-query compiler.version=<< windows_msvc_version >>
  tags:
    - WinVM

<% if ci_windows_vs2019 %>
<# The second Windows toolchain: msvc << vs2019_msvc_version >> (Visual Studio
   2019), from [ci].windows_vs2019. It was built by hand on a developer
   workstation for as long as no CI runner had VS2019 on it; GLR-UV does, so
   the same matrix is produced here instead -- reproducibly, on every pipeline,
   from the same `build.py` the msvc 194 job runs.

   Four things separate it from that job, and all four are load-bearing:

   * `--platform << vs2019_platform_key >>` selects the msvc 192 matrix. The
     recipe forks its third-party stack on compiler.version (boost 1.74.0.3 +
     zlib 1.2.11 rather than 1.86.0 + 1.3.1), and `build.py` drops the boost
     option defaults for this platform because the legacy recipe does not
     declare them -- Conan fails a build outright when a profile sets an
     option no recipe in the graph defines.
   * The `<< vs2019_remote_name >>` remote is added, and appended rather than
     inserted first: it must not become the first stop for every `conan
     install` on a shared runner. It is where the legacy dependencies are
     resolved from as well as where the results go.
   * Every deploy step carries `--package-query compiler.version=<<
     vs2019_msvc_version >>`. The Conan cache on a runner is per machine, not
     per job, so without it this job's `conan cache save` would tarball the
     msvc 194 job's binaries and publish them to the VS2019 remote, exit 0,
     and leave two toolchains mixed on a remote whose whole purpose is to keep
     them apart.
   * No `--wheel-dir`. A wheel's tags (`cp310-cp310-win_amd64`) say nothing
     about which MSVC built it, so an msvc 192 wheel and an msvc 194 wheel are
     the same devpi filename -- publishing both would have them overwrite each
     other by upload order. The VS2019 wheels the desktop products consume are
     still produced deliberately, by hand (USAGE section 16.8).

   `--build-missing` for the same reason the workstation driver passes it: the
   legacy dependency graph is not fully prebuilt for msvc 192. #>
"Conan Build - Windows VS2019":
<% if ci_split_tests %>
  stage: Build
<% else %>
  stage: Test
<% endif %>
  image: GLR-UV
  parallel:
    matrix:
<% for v in ci_python_versions %>
      - PYTHON_TARGET_VERSION: '<< v >>'
<% endfor %>
  artifacts:
    expire_in: '1d'
    when: always
    paths:
<% if ci_deploy %>
      - .export
<% endif %>
      - test_artifacts/
  script:
    - export PACKAGE_VERSION=${CI_COMMIT_TAG:-0.0.0}
    - export CTEST_PARALLEL_LEVEL=${CTEST_PARALLEL_LEVEL:-8}
<# See "Conan Build - Windows" above. This job needs it more than that one
   does: --build-missing means the msvc 192 dependencies are compiled from
   source, each running its own exported recipe, and nothing but an
   environment variable reaches those. #>
    - export UV_PYTHON=${PYTHON_TARGET_VERSION}
    - uv --version
    - uv venv --python ${PYTHON_TARGET_VERSION} .venv
    - source .venv/Scripts/activate
    - python --version
<# cmake from the venv, for the reasons given on "Conan Build - Windows"
   above. Same pin: the msvc 192 build runs the same generated CMakeLists on
   the same machines. #>
    - uv pip install "conan~=2.31.0" "cmake>=3.21" --index-url https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - uv pip install --upgrade "xmsconan>=<< xmsconan_version >>" --index-url https://public.aquapi.aquaveo.com/aquaveo/dev/+simple
    - cmake --version
    - xmsconan_conan_setup
<# Two `conan remote add` calls per job, on a fleet that runs several jobs per
   machine, all writing one ~/.conan2/remotes.json. Conan 2.31 writes it as
   `remotes.json.tmp` followed by `os.replace` (conan/api/subapi/remotes.py
   `_save`), so the file cannot be torn: a reader sees one complete document or
   the other. There is no lock around the read-modify-write, though, so two
   jobs adding remotes in the same instant can lose one of the two additions.

   Left as is deliberately. The lost update is loud -- the job that lost its
   remote fails resolving dependencies rather than publishing somewhere wrong
   -- and the alternative, a per-job CONAN_HOME, gives up the shared package
   cache these Windows builds depend on. That is a cache-model change with its
   own blast radius, not a footnote to this one. #>
    - xmsconan_conan_setup --remote-name << vs2019_remote_name >> --remote-url << vs2019_remote_url >> --append
    - xmsconan_gen --version ${PACKAGE_VERSION} build.toml
    - python build.py --version ${PACKAGE_VERSION} --platform << vs2019_platform_key >> --build-missing --artifacts-dir test_artifacts
<% if ci_deploy %>
    - xmsconan_conan_deploy << library_name >> ${PACKAGE_VERSION} --save .export/<< library_name >>-windows-vs2019-py${PYTHON_TARGET_VERSION}-${PACKAGE_VERSION}.tar.gz --package-query compiler.version=<< vs2019_msvc_version >>
<% endif %>
  tags:
    - WinVM

<% endif %>
<% endif %>
