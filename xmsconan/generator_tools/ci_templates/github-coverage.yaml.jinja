# The job installs the same `xmsconan[ci]` extra the CI workflow does, so
# its conan is the patch series the build workflow resolved package ids
# with: a coverage run on a different conan minor could measure a
# different set of binaries. The version comes from GITHUB_REF_NAME when
# GITHUB_REF_TYPE is `tag` (0.0.0 otherwise), read by the tool itself.
#
# The Conan credentials are set on the step that reaches the remote --
# the coverage run, which resolves this library's dependencies -- rather
# than on the job or on the setup step ahead of it. `xmsconan conan-setup`
# only writes the remote into this runner's Conan home; conan reads
# CONAN_LOGIN_USERNAME and CONAN_PASSWORD from the environment when it
# needs them. See the header of the CI workflow template.
#
# Generated by xmsconan_ci — do not edit manually.

name: << display_name >>-Coverage

on:
  push:
  pull_request:

jobs:
  coverage:
    name: Coverage (Linux)
    # The Coverage workflow runs directly on ubuntu-latest — no docker
    # container. The Aquaveo conan-gcc13-py3.13 image previously used
    # here baked xmsconan into the image; ``pip install xmsconan[ci]>=X.Y.Z``
    # then silently no-op'd because the in-image version already
    # satisfied the floor, locking every Coverage run to whatever
    # xmsconan the image happened to carry. Going containerless means
    # the canary always exercises the latest xmsconan on devpi.
    # ubuntu-latest currently ships gcc 13.3, matching the conan profile's
    # ``compiler.version=13``.
    runs-on: ubuntu-latest

    env:
      PYTHON_TARGET_VERSION: '<< coverage_python_version >>'
      CTEST_PARALLEL_LEVEL: '8'

    steps:
      - name: Checkout Source
        uses: actions/checkout@v4

      - name: Setup Python << coverage_python_version >>
        uses: actions/setup-python@v5
        with:
          python-version: '<< coverage_python_version >>'

<% if ci_xvfb %>
      - name: Install xvfb
        run: |
          sudo apt-get update
          sudo apt-get install -y xvfb
<% endif %>

      - name: Install Python Dependencies
        run: |
          pip install --upgrade "xmsconan[ci]<< xmsconan_requirement >>" -i https://public.aquapi.aquaveo.com/aquaveo/dev/+simple

      # No --remote-url: the value this passed was the tool's own default
      # spelled out again, so a change to the remote had to be made in two
      # places or the generated workflow kept pointing at the old one.
      - name: Setup Conan
        run: xmsconan conan-setup
        shell: bash

      - name: Run Coverage
        run: xmsconan coverage build.toml
        shell: bash
        env:
          CONAN_LOGIN_USERNAME: ${{ secrets.CONAN2_USER_SECRET }}
          CONAN_PASSWORD: ${{ secrets.CONAN2_PASSWORD_SECRET }}

      - name: Upload Coverage HTML
        uses: actions/upload-artifact@v4
        with:
          name: coverage-html
          path: |
            coverage-html-cpp/
            coverage-html-py/
          if-no-files-found: ignore
        if: always()

      - name: Upload Coverage XML
        uses: actions/upload-artifact@v4
        with:
          name: coverage-xml
          path: |
            cov-cpp.xml
            cov-py.xml
          if-no-files-found: ignore
        if: always()
